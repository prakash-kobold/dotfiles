# Enable Powerlevel10k instant prompt. Should stay close to the top of ~/.zshrc.
# Initialization code that may require console input (password prompts, [y/n]
# confirmations, etc.) must go above this block; everything else may go below.
if [[ -r "${XDG_CACHE_HOME:-$HOME/.cache}/p10k-instant-prompt-${(%):-%n}.zsh" ]]; then
  source "${XDG_CACHE_HOME:-$HOME/.cache}/p10k-instant-prompt-${(%):-%n}.zsh"
fi

## Setup zinit
ZINIT_HOME="${XDG_DATA_HOME:-${HOME}/.local/share}/zinit/zinit.git"
[ ! -d $ZINIT_HOME ] && mkdir -p "$(dirname $ZINIT_HOME)"
[ ! -d $ZINIT_HOME/.git ] && git clone https://github.com/zdharma-continuum/zinit.git "$ZINIT_HOME"
source "${ZINIT_HOME}/zinit.zsh"
autoload -Uz _zinit
(( ${+_comps} )) && _comps[zinit]=_zinit

## Powerlevel10k
zinit ice lucid depth"1"
zinit light romkatv/powerlevel10k

## OMZ — sensible defaults, no theme, no plugins
export ZSH=$HOME/.oh-my-zsh
ZSH_THEME=""
plugins=()
zstyle ':omz:lib:theme-and-appearance' gnu-ls yes
ENABLE_CORRECTION="true"
CORRECT_IGNORE_FILE='.*'
source $ZSH/oh-my-zsh.sh

## Plugins via zinit (turbo)
zinit wait lucid light-mode for \
       "OMZP::fzf" \
       has'fzf' @Aloxaf/fzf-tab \
       "OMZP::git" \
       "OMZP::zoxide"

# zinit's gh-r auto-detection grabs vivid's x86_64 tarball on arm64, which then
# dies with "bad CPU type in executable", so pin the asset explicitly. This file
# is not a chezmoi template, so gate at runtime rather than at apply time.
# Targets follow what upstream actually publishes: no aarch64 musl build exists,
# hence gnu for arm64 Linux and musl (static) for x86_64.
case "$OSTYPE:$CPUTYPE" in
  darwin*:(arm64|aarch64)) _vivid_asset='*aarch64-apple-darwin*' ;;
  darwin*)                 _vivid_asset='*x86_64-apple-darwin*' ;;
  linux*:(arm64|aarch64))  _vivid_asset='*aarch64-unknown-linux-gnu*' ;;
  *)                       _vivid_asset='*x86_64-unknown-linux-musl*' ;;
esac

zinit ice lucid from"gh-r" as"command" \
  bpick"$_vivid_asset" \
  mv"vivid-*/vivid -> vivid" \
  atload'export LS_COLORS="$(vivid generate one-dark)"; zstyle ":completion:*" list-colors "${(s.:.)LS_COLORS}"'
zinit light sharkdp/vivid
unset _vivid_asset

# Replay completions registered by turbo plugins after OMZ's compinit
zinit cdreplay -q

# History
HISTFILE=~/.zsh_history
HISTSIZE=1000000
SAVEHIST=$HISTSIZE
setopt HIST_IGNORE_ALL_DUPS
setopt HIST_FIND_NO_DUPS

# zsh history backups — one per day, keep last 10
export HIST_BACKUP_DIR="${HOME}/.zsh_history_backups"

function backup_zsh_history() {
    [[ -d "${HIST_BACKUP_DIR}" ]] || mkdir -p "${HIST_BACKUP_DIR}"
    local bak="${HIST_BACKUP_DIR}/zsh_history_$(date +%Y_%m_%d).bak"
    [[ -f "$bak" ]] || cp "${HISTFILE}" "$bak"
    local backups=("${HIST_BACKUP_DIR}"/*.bak(om))
    (( ${#backups} > 10 )) && rm "${backups[11,-1]}"
}

backup_zsh_history

# Separate up arrow lookback for local and global ZSH history
# up/down arrow steps through LOCAL terminal history
# Ctrl-up/down steps through GLOBAL terminal history
# Ctrl-R searches global terminal history
bindkey "${terminfo[kpp]}" up-line-or-local-history
bindkey "${terminfo[knp]}" down-line-or-local-history

up-line-or-local-history() {
    zle set-local-history 1
    zle up-line-or-history
    zle set-local-history 0
}
zle -N up-line-or-local-history
down-line-or-local-history() {
    zle set-local-history 1
    zle down-line-or-history
    zle set-local-history 0
}
zle -N down-line-or-local-history

bindkey "^[[1;5A" up-line-or-history    # [CTRL] + Cursor up
bindkey "^[[1;5B" down-line-or-history  # [CTRL] + Cursor down

# Use ctrl-p/n to go up/down search
bindkey "^P" up-line-or-beginning-search
bindkey "^N" down-line-or-beginning-search

# Source secrets if present
[[ ! -f ~/.shell-secrets ]] || source ~/.shell-secrets

# To customize prompt, run `p10k configure` or edit ~/.p10k.zsh.
[[ ! -f ~/.p10k.zsh ]] || source ~/.p10k.zsh
